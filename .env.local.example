# Supabase (server-side)
SUPABASE_URL=

# The PRIVILEGED key — Settings → API Keys → "Secret keys" → sb_secret_…
# Must be the sb_secret_ key (or a legacy JWT with role=service_role). It is the only key
# that bypasses RLS. The publishable/anon key does NOT: with RLS enabled it reads zero rows,
# which looks like missing data rather than a misconfiguration. This variable previously
# held the anon key by mistake; src/lib/db/client.ts now rejects a non-privileged key at
# startup rather than let that recur.
SUPABASE_SECRET_KEY=

# Signs the short-lived per-agent database JWTs (src/lib/db/actor-token.ts) so RLS can tell
# which account an agent belongs to. Settings → JWT Keys → "Legacy JWT Secret" → Reveal.
# Supabase now uses this secret only to VERIFY tokens, which is exactly what we rely on.
# If you ever disable the legacy JWT secret, minting stops and queries fall back to the
# secret key (RLS bypassed, with a loud warning) — see actor-token.ts.
SUPABASE_JWT_SECRET=

# Supabase (client-side, dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ship-faster
OWNER_TOKEN=            # single owner bearer token for local/personal use
OWNER_ACCOUNT_ID=       # optional; required once more than one account exists
